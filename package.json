{
  "name": "mercora",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "predev": "node scripts/db-local-ensure.mjs",
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:observability-worker": "vitest run --config vitest.observability.config.mts",
    "test:watch": "vitest",
    "predeploy": "node scripts/check-deploy-config.mjs",
    "deploy": "npm run clean && npm run build:worker && opennextjs-cloudflare deploy",
    "predeploy:ci": "node scripts/check-deploy-config.mjs",
    "deploy:ci": "node scripts/d1-migrate.mjs --target production --apply --confirm-production && opennextjs-cloudflare deploy",
    "check:migrations": "node scripts/check-migration-safety.mjs",
    "build:worker": "node scripts/build-with-public-env.mjs ./node_modules/.bin/opennextjs-cloudflare build",
    "clean": "rm -rf .open-next .next .wrangler/state .wrangler/public",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:prepare:local": "node scripts/db-local-ensure.mjs",
    "db:migrate:status:preview": "node scripts/d1-migrate.mjs --target preview",
    "db:migrate:apply:preview": "node scripts/d1-migrate.mjs --target preview --apply --confirm-preview",
    "db:migrate:status:production": "node scripts/d1-migrate.mjs --target production",
    "db:migrate:apply:production": "node scripts/d1-migrate.mjs --target production --apply --confirm-production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars false ./cloudflare-env.d.ts",
    "cf-typecheck": "wrangler types --env-interface CloudflareEnv --strict-vars false ./cloudflare-env.d.ts --check",
    "token:generate": "tsx scripts/manage-tokens.ts generate",
    "token:list": "tsx scripts/manage-tokens.ts list",
    "token:revoke": "tsx scripts/manage-tokens.ts revoke"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.4",
    "@clerk/themes": "^2.4.57",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@shadcn/ui": "^0.0.4",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^9.13.0",
    "@tailwindcss/typography": "^0.5.20",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "3.22.0",
    "lucide-react": "^1.30.0",
    "marked": "^18.0.9",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "resend": "^6.18.1",
    "sanitize-html": "2.17.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.6",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "tldts": "7.4.10",
    "web-vitals": "^6.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "^10.5.4",
    "csv-parse": "6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
