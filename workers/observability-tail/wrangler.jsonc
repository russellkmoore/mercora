{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "commerce-observability-tail",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALERT_COOLDOWN", "class_name": "AlertCooldown" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AlertCooldown"] }
  ],
  "send_email": [
    {
      // Unrestricted, matching the producer's EMAIL binding in the root wrangler.jsonc;
      // recipient and sender come from the vars below. Configured 2026-09-03.
      "name": "ALERT_EMAIL"
    }
  ],
  "vars": {
    // Cloudflare is recommended. Use "resend" with RESEND_API_KEY set as a
    // Wrangler secret for compatibility. No cross-provider fallback occurs.
    "EMAIL_PROVIDER": "cloudflare",
    "ALERT_EMAIL_TO": "russell@russellkmoore.me",
    "ALERT_EMAIL_FROM": "russell@russellkmoore.me",
    "ALERT_SUBJECT_PREFIX": "[voltique]",
    "OPERATOR_IDENTITY": "Russell K. Moore",
    "ENVIRONMENT": "production",
    "ALERT_COOLDOWN_SECONDS": "900",
    "ALERT_FAILURE_BACKOFF_SECONDS": "30"
  }
}
