# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Outbound email provider. Cloudflare Email Sending is recommended for Workers;
# configure the EMAIL send_email binding in wrangler.jsonc. Resend remains
# supported by setting EMAIL_PROVIDER=resend and RESEND_API_KEY as a secret.
# If omitted, Mercora selects a provider only when exactly one is configured.
# EMAIL_PROVIDER=cloudflare
# RESEND_API_KEY=re_your_resend_api_key_here

# Opt in to signed guest order-status links, then generate a secret with:
# openssl rand -hex 32
ORDER_STATUS_GUEST_LINKS_ENABLED=false
ORDER_STATUS_SECRET=

# Optional runtime carrier registry. Templates must be HTTPS and contain exactly
# one {trackingNumber} placeholder; the application safely URL-encodes it.
# STORE_CARRIERS_JSON=[{"code":"dhl","label":"DHL","trackingUrlTemplate":"https://www.dhl.com/global-en/home/tracking.html?tracking-id={trackingNumber}","legacyAliases":["DHL Express"]},{"code":"other","label":"Other","legacyAliases":[]}]

# Email identity and compliance. Secrets belong in encrypted bindings, not Git.
# STORE_SENDER_EMAIL=Demo Store <orders@example.com>
# STORE_REPLY_TO_EMAIL=support@example.com
# STORE_MERCHANT_NOTIFICATION_EMAIL=fulfillment@example.com
# STORE_POSTAL_ADDRESS=123 Example Street, Example City, CO 80000, USA
# EMAIL_UNSUBSCRIBE_SECRET_CURRENT=generate-at-least-32-random-characters
# EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS=previous-key-during-a-bounded-rotation-window
# EMAIL_UNSUBSCRIBE_TTL_SECONDS=2592000
# NEXT_PUBLIC_PRIVACY_URL=/privacy
# NEXT_PUBLIC_TERMS_URL=/terms
# NEXT_PUBLIC_RETURNS_URL=/returns

# Stripe API Keys
# Get these from your Stripe Dashboard at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Secret (for webhook endpoint security)
# Get this from your Stripe Dashboard webhooks section
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Sign up for a Stripe account at https://stripe.com
# 3. Go to your Stripe Dashboard
# 4. Copy your test API keys (use test keys for development)
# 5. Set up a webhook endpoint pointing to: https://yourdomain.com/api/webhooks/stripe
# 6. Copy the webhook signing secret
